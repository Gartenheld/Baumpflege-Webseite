---
// Vorlage für alle Leistungsseiten. Inhalte: src/inhalte/leistungen/<name>.md
// Leistungen, deren Qualifikation fehlt (z. B. Seilklettertechnik ohne SKT-A), werden nicht gebaut.
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Karten from '../../components/Karten.astro';
import Kosten from '../../components/Kosten.astro';
import FaqListe from '../../components/FaqListe.astro';
import Icon from '../../components/Icon.astro';
import LeistungsKarten from '../../components/LeistungsKarten.astro';
import OrteLinks from '../../components/OrteLinks.astro';
import KontaktAufruf from '../../components/start/KontaktAufruf.astro';
import AufrufBand from '../../components/AufrufBand.astro';
import Ablauf from '../../components/start/Ablauf.astro';
import { render } from 'astro:content';
import { sichtbareLeistungen, faqFuerLeistung, faqNachIds, orteSortiert, leistungsUrl } from '../../lib/inhalte';
import { dienstleistung } from '../../lib/strukturdaten';

export async function getStaticPaths() {
  const leistungen = await sichtbareLeistungen();
  return leistungen.map((leistung) => ({ params: { id: leistung.id }, props: { leistung } }));
}

const { leistung } = Astro.props;
const d = leistung.data;
const { Content } = await render(leistung);
// Höchstens 6 ausgewählte Fragen (Feld fragen in der Leistungsdatei), alle übrigen stehen auf der FAQ-Seite
const fragen = d.fragen
  ? await faqNachIds(d.fragen, `src/inhalte/leistungen/${leistung.id}.md`)
  : (await faqFuerLeistung(leistung.id)).slice(0, 6);
const anfrageLink = `/kontakt/?leistung=${leistung.id}`;
const orte = (await orteSortiert()).map((o) => o.data.name);
const service = dienstleistung(Astro.site!, leistungsUrl(leistung.id), d.titel, d.titel, d.beschreibung, orte);
---

<Basis title={d.seitentitel} description={d.beschreibung} foto={`leistung-${leistung.id}`} strukturdaten={[service]}>
  <Seitenkopf
    pfad={[{ titel: 'Leistungen', href: '/leistungen/' }, { titel: d.titel }]}
    kicker="Leistungen"
    titel={d.h1}
    einleitung={d.einleitung}
    knoepfe
    anfrageLink={anfrageLink}
    foto={`leistung-${leistung.id}`}
  />

  <section class="abschnitt abschnitt--weiss vorteile" aria-labelledby="vorteile-titel">
    <div class="huelle">
      <h2 id="vorteile-titel" class="sr-only">Ihre Vorteile</h2>
      <Karten karten={d.vorteile} />
    </div>
  </section>

  <section class="abschnitt" aria-label={d.titel}>
    <div class="huelle">
      <div class="prosa gegliedert"><Content /></div>
    </div>
  </section>

  <AufrufBand frage={d.aufruf} anfrageLink={anfrageLink} />

  <Ablauf hintergrund="creme" />

  <Kosten frage={d.kosten.frage} einleitung={d.kosten.einleitung} faktoren={d.kosten.faktoren} anfrageLink={anfrageLink} />

  {
    fragen.length > 0 && (
      <section class="abschnitt" aria-labelledby="faq-titel">
        <div class="huelle raster-seitlich">
          <div class="abschnittskopf">
            <p class="kicker">Häufige Fragen</p>
            <h2 id="faq-titel">{d.fragenTitel ?? `Fragen und Antworten: ${d.titel}`}</h2>
          </div>
          <FaqListe eintraege={fragen} />
          <div class="mehr-fragen">
            <p>Weitere Antworten, etwa zu Genehmigung, Kosten und Nachbarrecht, finden Sie in unseren häufigen Fragen.</p>
            <a href={`/faq/#leistung-${leistung.id}`}>Alle Fragen und Antworten <Icon name="pfeil" /></a>
          </div>
        </div>
      </section>
    )
  }

  <KontaktAufruf anfrageLink={anfrageLink} />

  <section class="abschnitt" aria-labelledby="weitere-titel">
    <div class="huelle">
      <div class="abschnittskopf">
        <p class="kicker">Leistungen</p>
        <h2 id="weitere-titel">Weitere Leistungen</h2>
      </div>
      <LeistungsKarten ohne={leistung.id} kompakt />
    </div>
  </section>

  <OrteLinks leistung={d.titel} />
</Basis>

<style>
  .mehr-fragen {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.5rem;
    max-width: 50rem;
  }

  .mehr-fragen p {
    color: var(--text-weich);
  }

  .mehr-fragen a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }

  .mehr-fragen :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  .abschnitt :global(.karten) li {
    background: var(--creme);
  }

  /* Vorteile: nur eine Reihe kurzer Karten, deshalb deutlich weniger Abstand oben und unten */
  .vorteile {
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
  }


  /* Leistungstext: ab Desktop Überschrift links, Text rechts, Abschnitte durch feine Linien getrennt */
  @media (min-width: 60rem) {
    .gegliedert {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 17rem) minmax(0, 44rem);
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }

    /* Im Raster fallen Außenabstände nicht zusammen, deshalb nur Abstände nach oben */
    .gegliedert > :global(*) {
      grid-column: 2;
      margin-bottom: 0;
    }

    /* Überschrift über mehrere Rasterzeilen, damit eine zweizeilige Überschrift keine Lücke im Text erzeugt */
    .gegliedert > :global(h2) {
      grid-column: 1;
      grid-row: span 12;
      font-size: 1.6rem;
      margin-top: 0;
    }

    .gegliedert > :global(h2 + *) {
      margin-top: 0;
    }

    .gegliedert > :global(h2:not(:first-child)),
    .gegliedert > :global(h2:not(:first-child) + *) {
      margin-top: 2.75rem;
      padding-top: 2.75rem;
      border-top: 1px solid var(--linie);
    }
  }
</style>
