---
// Vorlage für alle Leistungsseiten. Inhalte: src/inhalte/leistungen/<name>.md
// Leistungen, deren Qualifikation fehlt (z. B. Seilklettertechnik ohne SKT-A), werden nicht gebaut.
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Karten from '../../components/Karten.astro';
import Kosten from '../../components/Kosten.astro';
import FaqListe from '../../components/FaqListe.astro';
import LeistungsKarten from '../../components/LeistungsKarten.astro';
import KontaktAufruf from '../../components/start/KontaktAufruf.astro';
import { render } from 'astro:content';
import { sichtbareLeistungen, faqFuerLeistung } from '../../lib/inhalte';

export async function getStaticPaths() {
  const leistungen = await sichtbareLeistungen();
  return leistungen.map((leistung) => ({ params: { id: leistung.id }, props: { leistung } }));
}

const { leistung } = Astro.props;
const d = leistung.data;
const { Content } = await render(leistung);
const fragen = await faqFuerLeistung(leistung.id);
const anfrageLink = `/kontakt/?leistung=${leistung.id}`;
---

<Basis title={d.seitentitel} description={d.beschreibung}>
  <Seitenkopf
    pfad={[{ titel: 'Leistungen', href: '/leistungen/' }, { titel: d.titel }]}
    kicker="Leistungen"
    titel={d.h1}
    einleitung={d.einleitung}
    knoepfe
    anfrageLink={anfrageLink}
    foto={d.titel}
  />

  <section class="abschnitt abschnitt--weiss" aria-labelledby="vorteile-titel">
    <div class="huelle">
      <h2 id="vorteile-titel" class="sr-only">Ihre Vorteile</h2>
      <Karten karten={d.vorteile} />
    </div>
  </section>

  <section class="abschnitt" aria-label={d.titel}>
    <div class="huelle">
      <div class="prosa"><Content /></div>
    </div>
  </section>

  <Kosten frage={d.kosten.frage} einleitung={d.kosten.einleitung} faktoren={d.kosten.faktoren} anfrageLink={anfrageLink} />

  {
    fragen.length > 0 && (
      <section class="abschnitt" aria-labelledby="faq-titel">
        <div class="huelle">
          <div class="abschnittskopf">
            <p class="kicker">Häufige Fragen</p>
            <h2 id="faq-titel">Fragen zu {d.titel === 'Landschaftspflege und Heckenschnitt' ? 'Hecke und Landschaftspflege' : d.titel}</h2>
          </div>
          <FaqListe eintraege={fragen} />
          <p class="mehr-fragen"><a href="/faq/">Alle häufigen Fragen ansehen</a></p>
        </div>
      </section>
    )
  }

  <KontaktAufruf anfrageLink={anfrageLink} />

  <section class="abschnitt" aria-labelledby="weitere-titel">
    <div class="huelle">
      <div class="abschnittskopf">
        <h2 id="weitere-titel">Weitere Leistungen</h2>
      </div>
      <LeistungsKarten ohne={leistung.id} kompakt />
    </div>
  </section>
</Basis>

<style>
  .mehr-fragen {
    margin-top: 1.5rem;
    font-weight: 700;
  }

  .abschnitt :global(.karten) li {
    background: var(--sand);
  }
</style>
