---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import ReferenzKarten from '../components/ReferenzKarten.astro';
import KontaktAufruf from '../components/start/KontaktAufruf.astro';
import { render } from 'astro:content';
import { seite, sichtbareReferenzen } from '../lib/inhalte';

const s = await seite('referenzen');
const { Content } = await render(s);
const { liste, nurPlatzhalter } = await sichtbareReferenzen();
---

<Basis title={s.data.seitentitel} description={s.data.beschreibung}>
  <Seitenkopf pfad={[{ titel: 'Referenzen' }]} kicker={s.data.kicker} titel={s.data.h1} einleitung={s.data.einleitung}>
    <div class="prosa"><Content /></div>
  </Seitenkopf>

  <section class="abschnitt abschnitt--weiss" aria-label="Projekte">
    <div class="huelle">
      {nurPlatzhalter && liste.length > 0 && <p class="hinweis">Entwurf: Die Projekte unten sind Platzhalter und erscheinen so nicht auf der Live-Seite.</p>}
      {
        liste.length > 0 ? (
          <ReferenzKarten referenzen={liste} />
        ) : (
          <p class="leer">Hier zeigen wir in Kürze ausgewählte Projekte aus der Region, mit Fotos vorher und nachher.</p>
        )
      }
    </div>
  </section>

  <KontaktAufruf />
</Basis>

<style>
  .hinweis {
    color: var(--text-weich);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }

  .leer {
    font-size: 1.15rem;
    max-width: 40rem;
  }

  .abschnitt :global(.referenzen article) {
    background: var(--creme);
  }
</style>
