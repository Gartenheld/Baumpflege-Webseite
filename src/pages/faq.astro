---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import FaqListe from '../components/FaqListe.astro';
import Sprungmarken from '../components/Sprungmarken.astro';
import KontaktAufruf from '../components/start/KontaktAufruf.astro';
import { render } from 'astro:content';
import { seite, faqNachThema } from '../lib/inhalte';
import { fragenSeite } from '../lib/strukturdaten';

const s = await seite('faq');
const { Content } = await render(s);
const gruppen = await faqNachThema();
const faqDaten = fragenSeite(gruppen.flatMap((g) => g.fragen));
---

<Basis title={s.data.seitentitel} description={s.data.beschreibung} strukturdaten={[faqDaten]}>
  <Seitenkopf pfad={[{ titel: 'Häufige Fragen' }]} kicker={s.data.kicker} titel={s.data.h1} einleitung={s.data.einleitung}>
    <div class="prosa"><Content /></div>
    <Sprungmarken label="Themen" marken={gruppen.map((g) => ({ titel: g.titel, ziel: g.thema }))} />
  </Seitenkopf>

  {
    gruppen.map((g, i) => (
      <section class:list={['abschnitt', { 'abschnitt--weiss': i % 2 === 0 }]} id={g.thema} aria-labelledby={`${g.thema}-titel`}>
        <div class="huelle raster-seitlich">
          <div class="abschnittskopf">
            <h2 id={`${g.thema}-titel`}>{g.titel}</h2>
          </div>
          <FaqListe eintraege={g.fragen} />
        </div>
      </section>
    ))
  }

  <KontaktAufruf titel="Ihre Frage ist nicht dabei?" text="Schicken Sie uns Fotos und eine kurze Beschreibung oder rufen Sie uns an. Wir helfen Ihnen gern weiter." />
</Basis>

<style>
  .abschnitt--weiss :global(.faq details) {
    background: var(--creme);
  }

  section[id] {
    scroll-margin-top: 1rem;
  }
</style>
