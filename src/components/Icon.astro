---
// Einfache Linien-Symbole (24 x 24), Farbe über currentColor. Immer dekorativ, der Text steht daneben.
interface Props {
  name: 'telefon' | 'whatsapp' | 'mail' | 'pfeil' | 'kamera' | 'haken' | 'uhr' | 'menue' | 'ort' | 'instagram' | 'facebook';
  class?: string;
}

const { name, class: klasse } = Astro.props;
const pfade: Record<Props['name'], string> = {
  telefon: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/>',
  whatsapp: '<path d="M3 21l1.65-4.7A8.5 8.5 0 1 1 7.7 19.4z"/><path d="M9 10a.5.5 0 0 0 1 0v-1a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  pfeil: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
  kamera: '<path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"/><circle cx="12" cy="13" r="3.5"/>',
  haken: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  uhr: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  menue: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  ort: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  facebook: '<rect x="3" y="3" width="18" height="18" rx="4"/><path d="M15.5 7.5H14a2 2 0 0 0-2 2V21"/><path d="M9.5 12.5h5"/>',
};
---

<svg
  class:list={['icon', klasse]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={pfade[name]}
/>
