---
// Brotkrumen-Navigation (Startseite > Bereich > Seite). Der letzte Eintrag ist die aktuelle Seite.
import { brotkrumen, alsJson } from '../lib/strukturdaten';

interface Props {
  pfad: { titel: string; href?: string }[];
}

const { pfad } = Astro.props;
const jsonLd = alsJson([
  brotkrumen(Astro.site!, [
    { titel: 'Startseite', url: '/' },
    ...pfad.map((p, i) => ({ titel: p.titel, url: i === pfad.length - 1 || !p.href ? Astro.url.pathname : p.href })),
  ]),
]);
---

<nav class="brotkrumen" aria-label="Brotkrumen">
  <ol>
    <li><a href="/">Startseite</a></li>
    {
      pfad.map((p, i) => (
        <li>{i === pfad.length - 1 || !p.href ? <span aria-current="page">{p.titel}</span> : <a href={p.href}>{p.titel}</a>}</li>
      ))
    }
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={jsonLd} />

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.95rem;
    color: var(--text-weich);
  }

  li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--linie);
  }

  a {
    color: var(--text-weich);
  }

  a:hover {
    color: var(--gold-dunkel);
  }

  [aria-current='page'] {
    color: var(--text);
  }
</style>
