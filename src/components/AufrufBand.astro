---
// Schmaler Kontaktbalken zwischen den Abschnitten einer Seite: Frage, ein Satz, zwei Knöpfe.
import Icon from './Icon.astro';
import { betrieb, telefonLink } from '../config/betrieb';

interface Props {
  frage: string;
  text?: string;
  anfrageLink?: string;
}

const {
  frage,
  text = `Schicken Sie uns ein paar Fotos. Sie erhalten ${betrieb.antwortzeit} eine persönliche Antwort, die Ersteinschätzung ist kostenlos.`,
  anfrageLink = '/kontakt/',
} = Astro.props;
---

<section class="aufruf" aria-labelledby="aufruf-titel">
  <div class="huelle raster">
    <div class="text">
      <h2 id="aufruf-titel">{frage}</h2>
      <p>{text}</p>
    </div>
    <div class="knoepfe">
      <a class="knopf knopf--haupt" href={anfrageLink}><Icon name="kamera" />Anfrage mit Fotos senden</a>
      <a class="knopf knopf--hell" href={telefonLink}><Icon name="telefon" />Anrufen</a>
    </div>
  </div>
</section>

<style>
  .aufruf {
    background: var(--salbei-dunkel);
    border-top: 3px solid var(--gold);
    color: var(--auf-dunkel);
    --fokus: var(--gold-hell);
    padding-block: clamp(2.25rem, 5vw, 3rem);
  }

  .raster {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  .text {
    display: grid;
    gap: 0.5rem;
  }

  h2 {
    color: var(--auf-dunkel);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 1.9rem);
  }

  p {
    color: var(--auf-dunkel-weich);
    max-width: 38rem;
  }

  .knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 29.99rem) {
    .knoepfe .knopf {
      width: 100%;
    }
  }

  @media (min-width: 60rem) {
    .raster {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }
</style>
