---
// Kopfbereich einer Unterseite: Brotkrumen, Oberbegriff, H1, Einleitung, optional Knöpfe und Foto.
import Brotkrumen from './Brotkrumen.astro';
import Icon from './Icon.astro';
import Foto from './Foto.astro';
import { telefonLink } from '../config/betrieb';

interface Props {
  pfad: { titel: string; href?: string }[];
  kicker?: string;
  titel: string;
  einleitung?: string;
  knoepfe?: boolean;
  anfrageLink?: string;
  // Name eines Foto-Platzes aus src/config/fotos.ts
  foto?: string;
  // Freigestelltes Bildmotiv statt Foto: ohne Rahmen und Rundung, ganz sichtbar, etwas größer
  motiv?: boolean;
}

const { pfad, kicker, titel, einleitung, knoepfe = false, anfrageLink = '/kontakt/', foto, motiv = false } = Astro.props;
---

<header class:list={['seitenkopf', { 'seitenkopf--foto': foto, 'seitenkopf--motiv': motiv }]}>
  <div class="huelle raster">
    <div class="text">
      <Brotkrumen pfad={pfad} />
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{titel}</h1>
      {einleitung && <p class="einleitung">{einleitung}</p>}
      {
        knoepfe && (
          <div class="knoepfe">
            <a class="knopf knopf--haupt" href={anfrageLink}>
              <Icon name="kamera" />
              Anfrage mit Fotos senden
            </a>
            <a class="knopf knopf--rahmen" href={telefonLink}>
              <Icon name="telefon" />
              Anrufen
            </a>
          </div>
        )
      }
      <slot />
    </div>
    {foto && <Foto name={foto} class="bild" oben sizes="(min-width: 75rem) 33rem, (min-width: 60rem) 45vw, 100vw" />}
  </div>
</header>

<style>
  .seitenkopf {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .raster {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }

  .text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.1rem;
    max-width: 46rem;
  }

  .text :global(.brotkrumen) {
    margin-bottom: 0.5rem;
  }

  .knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .seitenkopf :global(.bild) {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
  }

  /* Bildmotiv: transparent auf dem Seitenhintergrund, ohne Übergang */
  .seitenkopf--motiv :global(.bild) {
    aspect-ratio: auto;
    border-radius: 0;
    object-fit: contain;
    width: min(100%, 19rem);
    justify-self: center;
  }

  @media (max-width: 29.99rem) {
    .knoepfe .knopf {
      width: 100%;
    }
  }

  @media (min-width: 60rem) {
    .seitenkopf--foto .raster {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 4rem;
    }

    .seitenkopf--motiv :global(.bild) {
      width: 100%;
      max-width: 32rem;
    }
  }
</style>
