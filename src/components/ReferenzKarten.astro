---
// Referenzprojekte als Karten mit Vorher-Nachher-Fotos. Ohne Fotos erscheint ein Platzhalter.
import { Picture } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import FotoPlatzhalter from './FotoPlatzhalter.astro';

interface Props {
  referenzen: CollectionEntry<'referenzen'>[];
}

const { referenzen } = Astro.props;
const monate = ['Januar', 'Februar', 'März', 'April', 'Mai', 'Juni', 'Juli', 'August', 'September', 'Oktober', 'November', 'Dezember'];
const datumText = (d: string) => `${monate[Number(d.slice(5, 7)) - 1]} ${d.slice(0, 4)}`;
const eintraege = await Promise.all(
  referenzen.map(async (r) => {
    const ort = await getEntry('orte', r.data.ort);
    const leistungen = await Promise.all(r.data.leistungen.map((l) => getEntry('leistungen', l)));
    return { r, ortName: ort?.data.name ?? r.data.ort, leistungen: leistungen.filter(Boolean).map((l) => l!.data.titel) };
  }),
);
---

<ul class="referenzen">
  {
    eintraege.map(({ r, ortName, leistungen }) => (
      <li>
        <article>
          <div class="bilder">
            {r.data.vorher ? (
              <figure>
                <Picture src={r.data.vorher} alt={r.data.vorherAlt ?? ''} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 60rem) 22rem, 50vw" />
                <figcaption>Vorher</figcaption>
              </figure>
            ) : (
              <FotoPlatzhalter text="Vorher" />
            )}
            {r.data.nachher ? (
              <figure>
                <Picture src={r.data.nachher} alt={r.data.nachherAlt ?? ''} formats={['avif', 'webp']} widths={[400, 700]} sizes="(min-width: 60rem) 22rem, 50vw" />
                <figcaption>Nachher</figcaption>
              </figure>
            ) : (
              <FotoPlatzhalter text="Nachher" />
            )}
          </div>
          <div class="text">
            <h3>{r.data.titel}</h3>
            <dl>
              <div><dt>Ort</dt><dd>{ortName}</dd></div>
              <div><dt>Baumart</dt><dd>{r.data.baumart}</dd></div>
              <div><dt>{leistungen.length > 1 ? 'Leistungen' : 'Leistung'}</dt><dd>{leistungen.join(', ')}</dd></div>
              <div><dt>Zeitpunkt</dt><dd>{datumText(r.data.datum)}</dd></div>
            </dl>
            <p>{r.data.aufgabe}</p>
          </div>
        </article>
      </li>
    ))
  }
</ul>

<style>
  .referenzen {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
  }

  article {
    background: var(--weiss);
    border-radius: var(--radius);
    overflow: hidden;
    height: 100%;
  }

  .bilder {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .bilder :global(.foto-platzhalter),
  .bilder :global(img) {
    aspect-ratio: 1;
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  figure {
    margin: 0;
    position: relative;
  }

  figcaption {
    position: absolute;
    left: 0.5rem;
    bottom: 0.5rem;
    background: color-mix(in srgb, var(--tiefgruen) 85%, transparent);
    color: var(--weiss);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  .text {
    padding: 1.4rem 1.5rem 1.6rem;
    display: grid;
    gap: 0.8rem;
  }

  h3 {
    font-size: 1.3rem;
  }

  dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 1rem;
    font-size: 1rem;
  }

  dl > div {
    display: contents;
  }

  dt {
    font-weight: 700;
    color: var(--text-weich);
  }

  dd {
    margin: 0;
  }

  p {
    color: var(--text-weich);
    font-size: 1.05rem;
  }
</style>
