---
// Abschnitt „Was kostet …?“: erklärt die Preisfaktoren, ohne Zahlen zu nennen.
import Icon from './Icon.astro';

interface Props {
  frage: string;
  einleitung: string;
  faktoren: { titel: string; text: string }[];
  anfrageLink?: string;
}

const { frage, einleitung, faktoren, anfrageLink = '/kontakt/' } = Astro.props;
---

<section class="abschnitt abschnitt--weiss" aria-labelledby="kosten-titel">
  <div class="huelle raster">
    <div class="text">
      <p class="kicker">Kosten</p>
      <h2 id="kosten-titel">{frage}</h2>
      <p class="einleitung">{einleitung}</p>
      <a class="knopf knopf--haupt" href={anfrageLink}><Icon name="kamera" />Kostenlose Ersteinschätzung anfragen</a>
      <a class="mehr" href="/kosten/">So entsteht unser Preis <Icon name="pfeil" /></a>
    </div>
    <dl>
      {
        faktoren.map((f) => (
          <div>
            <dt>{f.titel}</dt>
            <dd>{f.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .raster {
    display: grid;
    gap: 2.5rem;
  }

  .text {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .text .knopf {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .mehr {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }

  .mehr :global(.icon) {
    width: 1.1em;
    height: 1.1em;
  }

  dl {
    margin: 0;
    display: grid;
    gap: 0;
  }

  dl > div {
    padding: 1.1rem 0;
    border-top: 1px solid var(--linie);
  }

  dl > div:last-child {
    border-bottom: 1px solid var(--linie);
  }

  dt {
    font-weight: 700;
    color: var(--dunkelgruen);
    font-size: 1.1rem;
  }

  dd {
    margin: 0.25rem 0 0;
    color: var(--text-weich);
  }

  @media (min-width: 60rem) {
    .raster {
      grid-template-columns: 1fr 1.2fr;
      gap: 4rem;
    }
  }

  @media (max-width: 29.99rem) {
    .text .knopf {
      width: 100%;
    }
  }
</style>
