---
// Fragen und Antworten zum Aufklappen (ohne JavaScript). Antworttext aus src/inhalte/faq.
// Jede Frage hat eine eigene Adresse, z. B. /faq/#frage-kosten-steuer: Wer sie aufruft, sieht die Antwort aufgeklappt.
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  eintraege: CollectionEntry<'faq'>[];
}

const { eintraege } = Astro.props;
const mitInhalt = await Promise.all(eintraege.map(async (e) => ({ e, Inhalt: (await render(e)).Content })));
---

<div class="faq">
  {
    mitInhalt.map(({ e, Inhalt }) => (
      <details id={`frage-${e.id}`}>
        <summary>
          <span>{e.data.frage}</span>
        </summary>
        <div class="antwort prosa">
          <Inhalt />
        </div>
      </details>
    ))
  }
</div>

<script>
  // Aufruf über einen Link auf eine einzelne Frage: Antwort aufklappen
  const oeffnen = () => {
    const ziel = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (ziel instanceof HTMLDetailsElement && ziel.id.startsWith('frage-')) ziel.open = true;
  };
  oeffnen();
  window.addEventListener('hashchange', oeffnen);
</script>

<style>
  /* Ruhige Liste mit feinen Linien statt Kästen, Fragen in der Titelschrift */
  .faq {
    max-width: 50rem;
    border-top: 1px solid var(--linie);
  }

  details {
    border-bottom: 1px solid var(--linie);
    scroll-margin-top: 1.5rem;
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.2rem 0;
    font-family: var(--schrift-titel);
    font-weight: 600;
    font-size: clamp(1.08rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.35;
    color: var(--dunkelgruen);
    transition: color 0.15s ease;
  }

  summary:hover {
    color: var(--gold-dunkel);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Plus aus zwei feinen Linien, aufgeklappt bleibt der Strich */
  summary::after {
    content: '';
    flex-shrink: 0;
    width: 1.9rem;
    height: 1.9rem;
    margin-top: -0.15rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
    background:
      linear-gradient(var(--gold-dunkel), var(--gold-dunkel)) center / 0.75rem 1.5px no-repeat,
      linear-gradient(var(--gold-dunkel), var(--gold-dunkel)) center / 1.5px 0.75rem no-repeat;
    transition: background-size 0.2s ease, background-color 0.2s ease;
  }

  details[open] summary::after {
    background-color: color-mix(in srgb, var(--gold) 18%, transparent);
    background-size:
      0.75rem 1.5px,
      1.5px 0;
  }

  .antwort {
    padding: 0 3.4rem 1.6rem 0;
    font-size: 1.05rem;
    color: var(--text);
  }

  @media (max-width: 39.99rem) {
    .antwort {
      padding-right: 0;
    }
  }
</style>
