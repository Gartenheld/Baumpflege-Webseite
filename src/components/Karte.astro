---
// Schematische Karte des Einsatzgebiets aus Koordinaten (keine eingebettete Karte, keine Daten an Dritte).
// Bornheim ist als Standort markiert, optional wird ein weiterer Ort hervorgehoben.
import { orteSortiert, ortUrl } from '../lib/inhalte';

interface Props {
  hervorheben?: string;
}

const { hervorheben } = Astro.props;
const orte = await orteSortiert();

// Einfache Projektion: Längengrad gestaucht mit cos(Breite), Norden oben.
const B0 = 50.83;
const L0 = 6.94;
const K = 1700;
const COS = Math.cos((B0 * Math.PI) / 180);
const xy = (breite: number, laenge: number) => ({ x: 250 + (laenge - L0) * COS * K, y: 240 - (breite - B0) * K });

// Pfad durch Punkte als weiche Kurve (Catmull-Rom als kubische Bézierkurven), optional geschlossen
type P = { x: number; y: number };
const glatt = (punkte: number[][], geschlossen = false) => {
  const p: P[] = punkte.map(([b, l]) => xy(b, l));
  const n = p.length;
  const q = (i: number) => (geschlossen ? p[(i + n) % n] : p[Math.max(0, Math.min(n - 1, i))]);
  const f = (v: number) => v.toFixed(1);
  let d = `M${f(p[0].x)} ${f(p[0].y)}`;
  for (let i = 0; i < (geschlossen ? n : n - 1); i++) {
    const [a, b, c, e] = [q(i - 1), q(i), q(i + 1), q(i + 2)];
    d += ` C${f(b.x + (c.x - a.x) / 6)} ${f(b.y + (c.y - a.y) / 6)} ${f(c.x - (e.x - b.x) / 6)} ${f(c.y - (e.y - b.y) / 6)} ${f(c.x)} ${f(c.y)}`;
  }
  return geschlossen ? d + ' Z' : d;
};

// Rhein nach Natural Earth 1:10 Mio. (gemeinfrei), von Süd nach Nord
const rhein = glatt([
  [50.6511, 7.2055], [50.6696, 7.1965], [50.6866, 7.1853], [50.699, 7.175], [50.7101, 7.1591], [50.7287, 7.121],
  [50.7399, 7.106], [50.7637, 7.0886], [50.7695, 7.0712], [50.7804, 7.0434], [50.8055, 7.0281], [50.8199, 7.0066],
  [50.8305, 6.9854], [50.8399, 6.9756], [50.8554, 6.9863], [50.8749, 7.0356], [50.8908, 7.0514], [50.9017, 6.9856],
  [50.9184, 6.9736], [50.934, 6.9646], [50.9528, 6.9663], [50.9624, 6.9839], [50.9802, 6.9863], [50.99, 6.968],
]);

// Waldgebiete bewusst grob, nur zur Orientierung: Höhenzug Ville zwischen Erft und Rhein, Kottenforst bei Bonn
const ville = glatt(
  [
    [50.872, 6.835], [50.866, 6.872], [50.84, 6.888], [50.805, 6.9], [50.778, 6.93], [50.75, 6.958], [50.733, 6.962],
    [50.735, 6.935], [50.758, 6.9], [50.785, 6.868], [50.82, 6.84], [50.85, 6.822],
  ],
  true,
);
const kottenforst = glatt(
  [[50.722, 7.0], [50.72, 7.045], [50.705, 7.085], [50.675, 7.095], [50.67, 7.0], [50.69, 6.975], [50.71, 6.978]],
  true,
);

// Beschriftung je Ort: rechts (r) oder links (l) vom Punkt
const seite: Record<string, 'r' | 'l'> = {
  bornheim: 'l', alfter: 'l', bonn: 'r', bruehl: 'l', koeln: 'r', wesseling: 'r', huerth: 'l', erftstadt: 'l', weilerswist: 'l',
};
const punkte = orte.map((o) => ({ id: o.id, name: o.data.name, ...xy(o.data.breite, o.data.laenge), seite: seite[o.id] ?? 'r' }));
const titel = hervorheben && hervorheben !== 'bornheim'
  ? `Schematische Karte: ${orte.find((o) => o.id === hervorheben)?.data.name} und der Standort Bornheim zwischen Köln und Bonn`
  : 'Schematische Karte des Einsatzgebiets zwischen Köln und Bonn mit Standort Bornheim';
const id = `karte-${hervorheben ?? 'gebiet'}`;
const ortName = hervorheben && hervorheben !== 'bornheim' ? orte.find((o) => o.id === hervorheben)?.data.name : undefined;
const unterschrift = ortName
  ? `Schematische Darstellung, ${ortName} und Standort Bornheim hervorgehoben`
  : 'Schematische Darstellung, Standort Bornheim hervorgehoben';
---

<figure class="karte">
  <svg viewBox="0 0 520 480" role="group" aria-labelledby={id}>
    <title id={id}>{titel}</title>
    <g aria-hidden="true">
      <path class="wald" d={ville} />
      <path class="wald" d={kottenforst} />
      <path class="rhein" d={rhein} />
      <text class="gebiet" x="176" y="282" transform="rotate(58 176 282)">Ville</text>
      <text class="gebiet" x="347" y="460" text-anchor="middle">Kottenforst</text>
      <text class="fluss" x="388" y="182">Rhein</text>
    </g>
    {
      punkte.map((p) => {
        const sitz = p.id === 'bornheim';
        const aktiv = p.id === hervorheben && !sitz;
        return (
          <a href={ortUrl(p.id)} class:list={['ort', { 'ort--sitz': sitz, 'ort--aktiv': aktiv }]} aria-label={p.name}>
            {(sitz || aktiv) && <circle class="ring" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="16" />}
            <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={sitz || aktiv ? 8 : 5.5} />
            <text x={(p.x + (p.seite === 'r' ? 13 : -13)).toFixed(1)} y={(p.y + 6).toFixed(1)} text-anchor={p.seite === 'r' ? 'start' : 'end'}>
              {p.name}
            </text>
          </a>
        );
      })
    }
  </svg>
  <figcaption>{unterschrift}</figcaption>
</figure>

<style>
  .karte {
    margin: 0;
    background: var(--creme);
    border-radius: var(--radius);
    padding: clamp(1rem, 3vw, 2rem);
  }

  svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .rhein {
    fill: none;
    stroke: #a9c3c9;
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fluss {
    fill: #4f6f76;
    font-size: 18px;
    font-style: italic;
  }

  /* Hintergrund: Waldgebiete, zurückhaltend, damit die Orte vorne bleiben. */
  .wald {
    fill: #d9e1cc;
  }

  .gebiet {
    fill: var(--text-weich);
    font-size: 15px;
    font-style: italic;
    letter-spacing: 0.06em;
  }

  .ort circle {
    fill: var(--dunkelgruen);
  }

  .ort text {
    fill: var(--text);
    font-family: var(--schrift-text);
    font-size: 21px;
    font-weight: 600;
  }

  .ort:hover text,
  .ort:focus-visible text {
    fill: var(--gold-dunkel);
    text-decoration: underline;
  }

  .ort--sitz circle {
    fill: var(--gold);
  }

  .ort--aktiv circle {
    fill: var(--dunkelgruen);
  }

  .ring {
    fill: none !important;
    stroke-width: 2;
    opacity: 0.5;
  }

  .ort--sitz .ring {
    stroke: var(--gold);
    opacity: 0.9;
  }

  .ort--aktiv .ring {
    stroke: var(--dunkelgruen);
  }

  .ort--sitz text,
  .ort--aktiv text {
    font-size: 23px;
    font-weight: 700;
  }

  figcaption {
    margin-top: 0.5rem;
    text-align: center;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: var(--text-weich);
  }
</style>
