---
// Logo für Kopf und Fuß: Schriftzug „BAUMPFLEGE / goldene Linie / HAPPE“ (Stand 6. Oktober 2026).
// Bilddateien in src/assets/logo: schriftzug-dunkel.png für hellen Grund, schriftzug-hell.png für dunklen Grund.
// Das Monogramm „H“ ist eine eigene Komponente (Monogramm.astro).
// Neues Logo: Dateien mit gleichem Namen ersetzen (transparenter Hintergrund), siehe brand/README.md.
import { Picture } from 'astro:assets';
import schriftzugDunkel from '../assets/logo/schriftzug-dunkel.png';
import schriftzugHell from '../assets/logo/schriftzug-hell.png';

interface Props {
  negativ?: boolean;
  titel?: string;
  // Angezeigte Breite des Schriftzugs (etwa 3,4 mal seine Höhe) für die Bildauswahl des Browsers
  schriftzugSizes?: string;
  eager?: boolean;
}

const { negativ = false, titel = 'Baumpflege Happe', schriftzugSizes = '(min-width: 75rem) 15.5rem, 13.5rem', eager = false } = Astro.props;
const schriftzug = negativ ? schriftzugHell : schriftzugDunkel;
---

<span class="marke">
  <Picture
    src={schriftzug}
    formats={['avif', 'webp']}
    width={320}
    widths={[240, 320, 480, 640, 960]}
    sizes={schriftzugSizes}
    alt={titel}
    class="marke__schriftzug"
    loading={eager ? 'eager' : 'lazy'}
  />
</span>

<style>
  .marke {
    display: flex;
    align-items: center;
  }

  .marke :global(.marke__schriftzug) {
    display: block;
    width: auto;
    height: var(--schriftzug, 2.4rem);
  }
</style>
