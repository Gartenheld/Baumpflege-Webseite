---
// Logo für Kopf und Fuß (vorläufiges Logo): rundes Emblem und daneben der Schriftzug „Baumpflege Happe“.
// Bilddateien in src/assets/logo: emblem.png, schriftzug-dunkel.png (heller Grund), schriftzug-hell.png (dunkler Grund).
// Neues Logo: Dateien mit gleichem Namen ersetzen (transparenter Hintergrund).
import { Picture } from 'astro:assets';
import emblem from '../assets/logo/emblem.png';
import schriftzugDunkel from '../assets/logo/schriftzug-dunkel.png';
import schriftzugHell from '../assets/logo/schriftzug-hell.png';

interface Props {
  negativ?: boolean;
  titel?: string;
  // Angezeigte Größe des Emblems für die Bildauswahl des Browsers, z. B. "(min-width: 70rem) 3.75rem, 3rem"
  sizes: string;
  eager?: boolean;
}

const { negativ = false, titel = 'Baumpflege Happe', sizes, eager = false } = Astro.props;
const schriftzug = negativ ? schriftzugHell : schriftzugDunkel;
const laden = eager ? 'eager' : 'lazy';
---

<span class="marke">
  <Picture
    src={emblem}
    formats={['avif', 'webp']}
    width={128}
    height={128}
    widths={[64, 96, 128, 192, 256]}
    sizes={sizes}
    alt=""
    class="marke__emblem"
    loading={laden}
  />
  <Picture
    src={schriftzug}
    formats={['avif', 'webp']}
    width={240}
    widths={[180, 270, 360, 480, 720]}
    sizes="(min-width: 70rem) 13rem, 11rem"
    alt={titel}
    class="marke__schriftzug"
    loading={laden}
  />
</span>

<style>
  .marke {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .marke :global(.marke__emblem) {
    display: block;
    width: var(--emblem, 3rem);
    height: var(--emblem, 3rem);
    flex-shrink: 0;
  }

  .marke :global(.marke__schriftzug) {
    display: block;
    width: auto;
    height: var(--schriftzug, 2.4rem);
  }
</style>
