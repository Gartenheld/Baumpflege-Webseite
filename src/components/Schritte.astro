---
// Ablauf einer Leistung in kurzen, nummerierten Schritten („So gehen wir vor“).
interface Props {
  schritte: { titel: string; text: string }[];
  titel?: string;
}

const { schritte, titel = 'So gehen wir vor' } = Astro.props;
---

<section class="abschnitt" aria-labelledby="schritte-titel">
  <div class="huelle">
    <div class="abschnittskopf">
      <p class="kicker">Ablauf</p>
      <h2 id="schritte-titel">{titel}</h2>
    </div>
    <ol>
      {
        schritte.map((s) => (
          <li>
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: schritt;
    display: grid;
    gap: 1.5rem;
  }

  li {
    counter-increment: schritt;
    position: relative;
    padding-left: 3.75rem;
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  li::before {
    content: counter(schritt);
    position: absolute;
    left: 0;
    top: -0.2rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--gold);
    background: var(--weiss);
    color: var(--gold-dunkel);
    font-family: var(--schrift-titel);
    font-weight: 600;
    font-size: 1.15rem;
  }

  h3 {
    font-size: 1.2rem;
    text-wrap: balance;
  }

  p {
    color: var(--text-weich);
    line-height: 1.5;
  }

  /* Ab Desktop: Schritte nebeneinander, verbunden durch eine feine Linie */
  @media (min-width: 64rem) {
    ol {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    li {
      padding-left: 0;
      padding-top: 3.6rem;
    }

    li::after {
      content: '';
      position: absolute;
      top: 1.05rem;
      left: 3.25rem;
      right: -1.25rem;
      height: 1px;
      background: color-mix(in srgb, var(--gold) 55%, transparent);
    }

    li:last-child::after {
      display: none;
    }
  }
</style>
