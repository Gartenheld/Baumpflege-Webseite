---
// Allgemeiner Hinweis zur örtlichen Baumschutzsatzung mit Verweis auf die Stadt oder Gemeinde (keine Rechtsberatung).
import Icon from './Icon.astro';

interface Props {
  ort: string;
  status: 'satzung' | 'keine' | 'unklar';
  stelle: string;
  link: string;
  linktext?: string;
  regel?: string;
}

const { ort, status, stelle, link, linktext = 'Website der Verwaltung', regel } = Astro.props;
---

<aside class="baumschutz" aria-labelledby="baumschutz-titel">
  <h2 id="baumschutz-titel">Baumschutz in {ort}</h2>
  {status === 'satzung' && <p>In {ort} gilt eine Baumschutzsatzung. Ob Ihr Baum darunterfällt und ob eine Fällung genehmigt werden muss, entscheidet die Verwaltung.</p>}
  {status === 'keine' && <p>Für {ort} ist uns keine Baumschutzsatzung bekannt. Trotzdem können Schonzeit, Artenschutz und außerhalb der Ortslagen der Landschaftsplan gelten.</p>}
  {status === 'unklar' && <p>Ob in {ort} eine Baumschutzsatzung gilt und welche Bäume sie schützt, erfahren Sie bei der Verwaltung.</p>}
  {regel && <p>{regel} Maßgeblich ist die jeweils aktuelle Satzung.</p>}
  <p>Vom 1. März bis 30. September gilt außerdem die Schonzeit nach dem Bundesnaturschutzgesetz. Sie betrifft vor allem Hecken, Gebüsche und Bäume außerhalb von Gärten. Brütende Vögel und ihre Nester sind ganzjährig geschützt. Wir sprechen das bei der Planung mit Ihnen an.</p>
  <p class="link"><a href={link} rel="noopener">{stelle}: {linktext} <Icon name="pfeil" /></a></p>
  <p class="hinweis">Allgemeine Information, keine Rechtsberatung. Verbindlich ist die Auskunft der Verwaltung.</p>
</aside>

<style>
  .baumschutz {
    background: var(--flaeche);
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 2rem);
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }

  h2 {
    font-size: 1.5rem;
  }

  .link a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }

  .link :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .hinweis {
    font-size: 0.95rem;
    color: var(--text-weich);
  }
</style>
