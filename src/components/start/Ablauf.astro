---
// Ablauf der Anfrage in fünf Schritten, darunter eine schlanke Zeile für den persönlichen Kontakt
// (Telefon, WhatsApp, E-Mail) für alle, die lieber anrufen als ein Formular auszufüllen.
// Wird auf der Startseite und auf allen Leistungsseiten gleich gezeigt, nur der Hintergrund ist wählbar.
import Icon from '../Icon.astro';
import { betrieb, telefonLink, whatsappLink, mailLink } from '../../config/betrieb';

interface Props {
  hintergrund?: 'weiss' | 'creme';
}

const { hintergrund = 'weiss' } = Astro.props;

const schritte = [
  { titel: 'Anfrage', text: 'Mit Fotos über das Formular oder persönlich per Telefon, WhatsApp oder E-Mail.' },
  { titel: 'Antwort in 24 Stunden', text: 'Persönlich und an Werktagen, mit einer ersten Einschätzung oder Rückfragen.' },
  { titel: 'Besichtigung', text: 'Wenn nötig, beurteilen wir Baum, Standort und Zufahrt vor Ort.' },
  { titel: 'Angebot', text: 'Schriftlich und mit Pauschalpreis. Ersteinschätzung, Besichtigung und Angebot sind für Sie kostenlos.' },
  { titel: 'Ausführung', text: 'Fachgerecht und sorgfältig. Ihr Grundstück hinterlassen wir sauberer, als wir es vorgefunden haben.' },
];
---

<section class:list={['abschnitt', 'ablauf', `ablauf--${hintergrund}`]} aria-labelledby="ablauf-titel">
  <div class="huelle">
    <div class="kopfzeile">
      <p class="kicker">Ablauf</p>
      <h2 id="ablauf-titel">Von der Anfrage bis zur Ausführung</h2>
    </div>

    <ol>
      {
        schritte.map((s) => (
          <li>
            <h3>{s.titel}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="direkt">
      <p class="direkt__frage">Lieber persönlich?</p>
      <ul>
        <li>
          <a href={telefonLink}><Icon name="telefon" />{betrieb.telefon.anzeige}</a>
        </li>
        <li>
          <a href={whatsappLink}><Icon name="whatsapp" />WhatsApp</a>
        </li>
        <li>
          <a href={mailLink}><Icon name="mail" />{betrieb.email}</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .ablauf--weiss {
    background: var(--weiss);
  }

  .ablauf--creme {
    background: var(--creme);
  }

  .kopfzeile {
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2.75rem;
  }

  .kopfzeile .kicker {
    font-size: 1.15rem;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: schritt;
    display: grid;
    gap: 1.6rem;
  }

  li {
    counter-increment: schritt;
    position: relative;
    padding-left: 3.75rem;
    display: grid;
    gap: 0.3rem;
    align-content: start;
  }

  ol li::before {
    content: counter(schritt);
    position: absolute;
    left: 0;
    top: -0.2rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--gold);
    color: var(--gold-dunkel);
    font-family: var(--schrift-titel);
    font-weight: 600;
    font-size: 1.15rem;
  }

  h3 {
    font-size: 1.25rem;
    text-wrap: balance;
  }

  ol p {
    color: var(--text-weich);
    font-size: 1rem;
    line-height: 1.5;
  }

  /* Persönlicher Kontakt als schlanke Zeile unter den Schritten */
  .direkt {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--linie);
    display: grid;
    gap: 0.9rem;
  }

  .direkt__frage {
    font-family: var(--schrift-titel);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--dunkelgruen);
  }

  .direkt ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .direkt li {
    padding: 0;
  }

  .direkt a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-weight: 600;
    color: var(--dunkelgruen);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .direkt a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }

  .direkt :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
    color: var(--gold-dunkel);
  }

  /* Ab Desktop: Schritte nebeneinander mit feiner Verbindungslinie, Kontakt in einer Zeile */
  @media (min-width: 64rem) {
    ol {
      grid-template-columns: repeat(5, 1fr);
      gap: 2rem;
    }

    ol li {
      padding-left: 0;
      padding-top: 3.6rem;
    }

    ol li::after {
      content: '';
      position: absolute;
      top: 1.05rem;
      left: 3.25rem;
      right: -1.25rem;
      height: 1px;
      background: color-mix(in srgb, var(--gold) 55%, transparent);
    }

    ol li:last-child::after {
      display: none;
    }

    .direkt {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 2.5rem;
    }

    .direkt ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 2.25rem;
    }
  }
</style>
