---
// Einstieg der Startseite in voller Breite: Hintergrundvideo (src/videos/startseite.mp4), sonst eigenes Foto
// (src/bilder/startseite.jpg), sonst ruhiger dunkelgrüner Hintergrund mit Baumsymbol. Text liegt abgedunkelt darüber.
import { getImage } from 'astro:assets';
import { PUBLIC_NOINDEX } from 'astro:env/client';
import Icon from '../Icon.astro';
import Foto from '../Foto.astro';
import Monogramm from '../Monogramm.astro';
import { LOGO } from '../logo-daten';
import { betrieb, telefonLink } from '../../config/betrieb';
import { video } from '../../lib/videos';
import { foto } from '../../lib/fotos';

const v = video('startseite');
const hatFoto = !v && Boolean(foto('startseite').bild);
const standbild = v?.standbild ? (await getImage({ src: v.standbild, width: 1280, format: 'webp', quality: 50 })).src : undefined;
---

<section class:list={['einstieg', { 'einstieg--video': v, 'einstieg--foto': hatFoto }]} aria-labelledby="einstieg-titel">
  <div class="einstieg__hintergrund" aria-hidden="true">
    {
      v ? (
        <video
          class="einstieg__video"
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="none"
          poster={standbild}
        >
          {/* MP4 zuerst: läuft in allen gängigen Browsern, auch in Safari auf iPhone und Mac. WebM nur als Ausweich. */}
          {v.klein && <source src={v.klein} type="video/mp4" media="(max-width: 47.99rem)" />}
          {v.kleinWebm && <source src={v.kleinWebm} type="video/webm" media="(max-width: 47.99rem)" />}
          <source src={v.mp4} type="video/mp4" />
          {v.webm && <source src={v.webm} type="video/webm" />}
        </video>
      ) : hatFoto ? (
        <Foto name="startseite" oben sizes="100vw" widths={[640, 960, 1280, 1920, 2560]} />
      ) : (
        <svg class="einstieg__symbol" viewBox={LOGO.symbol.viewBox} fill="currentColor" set:html={LOGO.symbol.inhalt} />
      )
    }
  </div>

  <div class="huelle einstieg__inhalt">
    <div class="einstieg__text">
      <p class="einstieg__claim">{betrieb.claim}</p>
      <h1 id="einstieg-titel">Baumpflege und Baumfällung in Bornheim, Köln und Bonn</h1>
      <p class="einstieg__einleitung">
        Fachkundige Pflege und sorgfältige Fällungen für Bäume, die Ihrem Grundstück Wert und Charakter geben.
        Persönlich vom Inhaber betreut, genau geplant und mit Rücksicht auf Haus und Garten ausgeführt.
      </p>
      <div class="einstieg__knoepfe">
        <a class="knopf knopf--haupt" href="/kontakt/"><Icon name="kamera" />Anfrage mit Fotos senden</a>
        <a class="knopf knopf--hell" href={telefonLink}><Icon name="telefon" />Anrufen</a>
      </div>
      <ul class="einstieg__punkte">
        <li><Icon name="haken" />Antwort innerhalb von 24 Stunden (werktags)</li>
        <li><Icon name="haken" />Schriftliches Angebot mit Pauschalpreis</li>
        <li><Icon name="haken" />Kostenfreies Angebot</li>
      </ul>
    </div>
  </div>

  {/* Monogramm dezent rechts in der Mitte (ab Desktop), der Pause-Knopf steht darunter unten rechts */}
  <div class="einstieg__marke" aria-hidden="true">
    <Monogramm negativ sizes="4rem" eager />
  </div>

  {
    v && (
      <button class="einstieg__pause" type="button" data-zustand="laeuft" hidden>
        <Icon name="pause" class="symbol-pause" />
        <Icon name="abspielen" class="symbol-abspielen" />
        <span class="sr-only">Hintergrundvideo anhalten</span>
      </button>
    )
  }
  {!v && !hatFoto && PUBLIC_NOINDEX && <p class="einstieg__hinweis">Hintergrundvideo folgt</p>}
</section>

<script>
  // Hintergrundvideo starten und Pause-Knopf. Das Video lädt erst, wenn die Seite fertig geladen ist: Bis dahin
  // zeigt das Standbild, und Text, Schriften und Fotos werden nicht ausgebremst. Blockiert der Browser den
  // automatischen Start (z. B. Stromsparmodus am iPhone), zeigt der Knopf „abspielen“.
  // Im Datensparmodus startet das Video nicht von selbst.
  const film = document.querySelector<HTMLVideoElement>('.einstieg__video');
  const knopf = document.querySelector<HTMLButtonElement>('.einstieg__pause');
  if (film && knopf) {
    const text = knopf.querySelector('.sr-only');
    const zeige = () => {
      const laeuft = !film.paused;
      knopf.dataset.zustand = laeuft ? 'laeuft' : 'pause';
      if (text) text.textContent = laeuft ? 'Hintergrundvideo anhalten' : 'Hintergrundvideo abspielen';
    };
    const sparen = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    film.addEventListener('play', zeige);
    film.addEventListener('pause', zeige);
    knopf.addEventListener('click', () => (film.paused ? film.play().catch(zeige) : film.pause()));
    const starten = () => film.play().catch(zeige);
    if (sparen) {
      zeige();
    } else if (document.readyState === 'complete') {
      starten();
    } else {
      window.addEventListener('load', starten, { once: true });
    }
    knopf.hidden = false;
  }
</script>

<style>
  .einstieg {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--tiefgruen);
    --fokus: var(--gold-hell);
    color: var(--auf-dunkel);
    display: flex;
    align-items: center;
    min-height: clamp(34rem, 78vh, 46rem);
  }

  /* Hintergrund: Video, Foto oder Symbol, darüber eine Abdunklung für gut lesbaren Text */
  .einstieg__hintergrund {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .einstieg__hintergrund::after {
    content: '';
    position: absolute;
    inset: 0;
    /* Handy: so hell, dass die Bewegung sichtbar bleibt, Text und Claim behalten genug Kontrast */
    background: color-mix(in srgb, var(--tiefgruen) 70%, transparent);
  }

  .einstieg__video,
  .einstieg__hintergrund :global(.foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  /* Handy und Tablet: Ausschnitt nach rechts, damit die Motorsäge im Bild ist */
  .einstieg__video {
    object-position: 85% 50%;
  }

  .einstieg__symbol {
    position: absolute;
    right: -6%;
    bottom: -12%;
    height: 115%;
    width: auto;
    color: var(--auf-dunkel);
    opacity: 0.05;
  }

  .einstieg__inhalt {
    width: 100%;
    padding-block: 3.5rem 4rem;
  }

  /* Monogramm erst ab Desktop, auf dem Handy bleibt der Platz für den Text */
  .einstieg__marke {
    display: none;
  }

  /* Handy: oben etwas enger, unten Platz für den Abspielknopf, damit alles über die Leiste am unteren Rand passt */
  .einstieg--video .einstieg__inhalt {
    padding-block: 2.25rem 4.75rem;
  }

  .einstieg__text {
    display: grid;
    gap: 1.25rem;
    max-width: 40rem;
  }

  .einstieg__claim {
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--gold-licht);
    /* dunkler Schein, damit der Claim auch über hellen Stellen im Video lesbar bleibt */
    text-shadow:
      0 0 0.5em color-mix(in srgb, var(--tiefgruen) 90%, transparent),
      0 1px 2px color-mix(in srgb, var(--tiefgruen) 90%, transparent);
  }

  .einstieg h1 {
    font-size: clamp(2.2rem, 1.4rem + 3vw, 3.7rem);
    color: var(--auf-dunkel);
  }

  .einstieg__einleitung {
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.3rem);
    line-height: 1.55;
    color: var(--auf-dunkel);
  }

  .einstieg__knoepfe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .einstieg__punkte {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 1rem;
    color: var(--auf-dunkel);
  }

  .einstieg__punkte li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .einstieg__punkte :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--gold-licht);
  }

  /* Unten rechts (Handy und Desktop); auf breiten Bildschirmen steht rechts in der Mitte das Monogramm */
  .einstieg__pause {
    position: absolute;
    right: var(--rand);
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--auf-dunkel) 50%, transparent);
    background: color-mix(in srgb, var(--tiefgruen) 55%, transparent);
    color: var(--auf-dunkel);
    cursor: pointer;
  }

  /* Handy: über die Leiste mit Anrufen und WhatsApp heben, wenn sie den Knopf sonst halb verdeckt,
     aber höchstens bis neben die Haken-Punkte, nie in den Text darüber */
  @supports (top: 1svh) {
    .einstieg__pause {
      top: clamp(calc(100% - 7rem), calc(100svh - 13rem), calc(100% - 4rem));
      bottom: auto;
    }
  }

  .einstieg__pause[hidden] {
    display: none;
  }

  .einstieg__pause:hover {
    background: color-mix(in srgb, var(--tiefgruen) 85%, transparent);
  }

  .einstieg__pause :global(.icon) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .einstieg__pause[data-zustand='laeuft'] :global(.symbol-abspielen),
  .einstieg__pause[data-zustand='pause'] :global(.symbol-pause) {
    display: none;
  }

  .einstieg__hinweis {
    position: absolute;
    right: var(--rand);
    bottom: 1rem;
    font-size: 0.8rem;
    color: var(--auf-dunkel-weich);
  }

  @media (max-width: 29.99rem) {
    .einstieg__knoepfe .knopf {
      width: 100%;
    }
  }

  /* Breite Bildschirme: links dunkler für den Text, rechts mehr vom Video sichtbar */
  @media (min-width: 60rem) {
    .einstieg__hintergrund::after {
      background: linear-gradient(90deg, color-mix(in srgb, var(--tiefgruen) 86%, transparent) 0%, color-mix(in srgb, var(--tiefgruen) 78%, transparent) 40%, color-mix(in srgb, var(--tiefgruen) 40%, transparent) 100%);
    }

    .einstieg__inhalt,
    .einstieg--video .einstieg__inhalt {
      padding-block: 5rem;
    }

    .einstieg__marke {
      display: block;
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      right: var(--rand);
      --monogramm: 4rem;
      opacity: 0.85;
      filter: drop-shadow(0 2px 12px color-mix(in srgb, var(--tiefgruen) 80%, transparent));
      pointer-events: none;
    }

    .einstieg__video {
      object-position: 50% 50%;
    }

    /* Unten rechts, mittig unter dem Monogramm */
    .einstieg__pause {
      bottom: 2.5rem;
      right: calc(var(--rand) + 0.15rem);
      width: 3.5rem;
      height: 3.5rem;
    }

    /* Beim Öffnen der Seite ganz sichtbar: Ist der Einstieg höher als das Fenster, rückt der Knopf
       nach oben (Fensterhöhe minus Kopfzeile, Abstand und Knopf), aber nie über das Monogramm */
    @supports (top: 1svh) {
      .einstieg__pause {
        top: clamp(calc(50% + 3rem), calc(100svh - 11rem), calc(100% - 6rem));
        bottom: auto;
      }
    }
  }
</style>
