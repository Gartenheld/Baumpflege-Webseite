---
import Icon from '../Icon.astro';
import Karte from '../Karte.astro';
import { orteSortiert, ortUrl } from '../../lib/inhalte';

const orte = await orteSortiert();
---

<section class="abschnitt einsatz" aria-labelledby="einsatz-titel">
  <div class="huelle raster">
    <div class="text">
      <p class="kicker">Einsatzgebiet</p>
      <h2 id="einsatz-titel">Zwischen Köln und Bonn im Einsatz</h2>
      <p class="einleitung">
        Unser Betrieb sitzt in Bornheim. Von hier aus sind wir in der ganzen Region unterwegs, unter anderem in diesen Orten:
      </p>
      <ul class="orte">
        {
          orte.map((o) => (
            <li>
              <a href={ortUrl(o.id)}>
                <Icon name="ort" />
                {o.data.name}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="hinweis">Ihr Ort ist nicht dabei? Fragen Sie gern nach.</p>
    </div>

    <Karte />
  </div>
</section>

<style>
  .einsatz {
    background: var(--weiss);
  }

  .raster {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .text {
    display: grid;
    gap: 1rem;
  }

  .orte {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: 0.5rem 1rem;
  }

  .orte a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: none;
  }

  .orte a:hover {
    text-decoration: underline;
  }

  .orte :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--gold-dunkel);
  }

  .hinweis {
    color: var(--text-weich);
    font-size: 1rem;
  }

  @media (min-width: 60rem) {
    .raster {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
    }
  }
</style>
