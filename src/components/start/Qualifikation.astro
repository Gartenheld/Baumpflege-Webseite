---
// Fachlichkeit auf der Startseite: vier Punkte in Alltagssprache, ohne Kürzel. Die einzelnen
// Qualifikationen (AS Baum, SKT, BSB) stehen auf der Seite „Über uns“.
// Die Punkte richten sich nach den vorhandenen Qualifikationen in src/inhalte/qualifikationen.
import Icon from '../Icon.astro';
import { vorhandeneQualifikationen } from '../../lib/inhalte';

const vorhanden = new Set((await vorhandeneQualifikationen()).map((q) => q.id));

const punkte = [
  (vorhanden.has('as-baum-1') || vorhanden.has('as-baum-2')) && {
    titel: 'Ausgebildet für Fällungen',
    text: vorhanden.has('as-baum-2')
      ? 'Auch anspruchsvolle Fällungen führen wir mit der dafür nötigen Ausbildung sicher aus.'
      : 'Fällungen führen wir mit der dafür nötigen Ausbildung sicher aus.',
  },
  {
    titel: 'Sicher in der Krone',
    text: vorhanden.has('skt-a')
      ? 'Am Seil oder mit der Hubarbeitsbühne kommen wir sicher in die Krone, auch in engen Gärten.'
      : 'Mit der Hubarbeitsbühne kommen wir sicher in die Krone.',
  },
  vorhanden.has('bsb-1') && {
    titel: 'Erst prüfen, dann arbeiten',
    text: 'Bevor wir klettern oder fällen, schätzen wir ein, wie sicher der Baum noch steht.',
  },
  {
    titel: 'Sauber bis zum Schluss',
    text: 'Schnittgut häckseln wir mit dem eigenen Häcksler vor Ort. Ihr Grundstück ist danach sauberer als vorher.',
  },
].filter((p): p is { titel: string; text: string } => Boolean(p));
---

<section class="abschnitt qualifikation" aria-labelledby="qualifikation-titel">
  <div class="huelle">
    <div class="kopf">
      <div class="abschnittskopf">
        <p class="kicker">Fachlichkeit</p>
        <h2 id="qualifikation-titel">Erfahren, ausgebildet und gut ausgerüstet</h2>
      </div>
      <a class="knopf knopf--hell" href="/ueber-uns/">Mehr über uns <Icon name="pfeil" /></a>
    </div>
    <ul class="punkte">
      {
        punkte.map((p) => (
          <li>
            <span class="zeichen" aria-hidden="true">
              <Icon name="haken" />
            </span>
            <h3>{p.titel}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .qualifikation {
    background: var(--salbei);
    --fokus: var(--gold-hell);
    color: var(--auf-dunkel);
  }

  .kopf {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .kopf .abschnittskopf {
    margin-bottom: 0;
  }

  .kopf .knopf {
    justify-self: start;
  }

  .kicker {
    color: var(--gold-hell);
  }

  h2,
  h3 {
    color: var(--auf-dunkel);
  }

  .punkte {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.75rem;
  }

  .punkte li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 2px solid var(--gold);
  }

  .zeichen {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 0.35rem;
    border-radius: 50%;
    border: 1.5px solid var(--gold-licht);
    color: var(--gold-licht);
  }

  .zeichen :global(.icon) {
    width: 1.15rem;
    height: 1.15rem;
  }

  h3 {
    font-size: 1.2rem;
  }

  .punkte p {
    color: var(--auf-dunkel-weich);
    line-height: 1.5;
  }

  @media (min-width: 40rem) {
    .punkte {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .kopf {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .punkte {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
      grid-template-columns: none;
    }
  }
</style>
