---
import Icon from '../Icon.astro';
import { vorhandeneQualifikationen } from '../../lib/inhalte';

const qualifikationen = await vorhandeneQualifikationen();
---

<section class="abschnitt qualifikation" aria-labelledby="qualifikation-titel">
  <div class="huelle raster">
    <div class="text">
      <p class="kicker">Fachlichkeit</p>
      <h2 id="qualifikation-titel">Qualifiziert und gut ausgerüstet</h2>
      <p>
        Arbeiten an Bäumen verlangen Erfahrung, Sorgfalt und die passende Qualifikation. Wir planen jeden Einsatz
        sorgfältig und arbeiten mit eigener Ausrüstung, darunter Häcksler und Pritschenwagen mit Kipper.
      </p>
      <a class="knopf knopf--hell" href="/ueber-uns/">Mehr über uns <Icon name="pfeil" /></a>
    </div>
    <ul class="liste">
      {
        qualifikationen.map((q) => (
          <li>
            <h3>{q.data.titel}</h3>
            <p>{q.data.erklaerung}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .qualifikation {
    background: var(--tanne);
    color: var(--auf-dunkel);
  }

  .raster {
    display: grid;
    gap: 2.5rem;
  }

  .text {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .kicker {
    color: var(--kupfer-hell);
  }

  h2,
  h3 {
    color: var(--auf-dunkel);
  }

  .text p {
    color: var(--auf-dunkel-weich);
    max-width: 34rem;
  }

  .text .knopf {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .liste li {
    border: 1px solid rgb(243 238 230 / 0.22);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    display: grid;
    gap: 0.4rem;
  }

  .liste p {
    color: var(--auf-dunkel-weich);
    font-size: 1.05rem;
  }

  @media (min-width: 60rem) {
    .raster {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
