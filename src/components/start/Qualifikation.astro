---
import Icon from '../Icon.astro';
import { vorhandeneQualifikationen, qualifikationenBeiBedarf } from '../../lib/inhalte';

const qualifikationen = await vorhandeneQualifikationen();
const beiBedarf = await qualifikationenBeiBedarf();
---

<section class="abschnitt qualifikation" aria-labelledby="qualifikation-titel">
  <div class="huelle raster">
    <div class="text">
      <p class="kicker">Fachlichkeit</p>
      <h2 id="qualifikation-titel">Erfahren, qualifiziert und gut ausgerüstet</h2>
      <p>
        Arbeiten an Bäumen verlangen Erfahrung, Sorgfalt und die passende Qualifikation. Wir bringen mehrjährige
        Erfahrung in Baumpflege und Baumfällung mit und planen jeden Einsatz sorgfältig. In die Krone kommen wir mit
        der Hubarbeitsbühne oder am Seil, das Schnittgut häckseln wir mit dem eigenen Häcksler vor Ort.
      </p>
      <a class="knopf knopf--hell" href="/ueber-uns/">Mehr über uns <Icon name="pfeil" /></a>
    </div>
    <ul class="liste">
      {
        qualifikationen.map((q) => (
          <li>
            <h3>{q.data.titel}</h3>
            <p>{q.data.erklaerung}</p>
          </li>
        ))
      }
      {
        beiBedarf.map((q) => (
          <li class="bei-bedarf">
            <h3>
              {q.data.titel} <span class="etikett">bei Bedarf im Einsatz</span>
            </h3>
            <p>{q.data.erklaerung}</p>
            {q.data.hinweis && <p>{q.data.hinweis}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .qualifikation {
    background: var(--salbei);
    --fokus: var(--gold-hell);
    color: var(--auf-dunkel);
  }

  .raster {
    display: grid;
    gap: 2.5rem;
  }

  .text {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .kicker {
    color: var(--gold-hell);
  }

  h2,
  h3 {
    color: var(--auf-dunkel);
  }

  .text p {
    color: var(--auf-dunkel-weich);
    max-width: 34rem;
  }

  .text .knopf {
    justify-self: start;
    margin-top: 0.5rem;
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .liste li {
    border: 1px solid color-mix(in srgb, var(--auf-dunkel) 22%, transparent);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    display: grid;
    gap: 0.4rem;
  }

  .liste p {
    color: var(--auf-dunkel-weich);
    font-size: 1.05rem;
  }

  .liste .bei-bedarf {
    border-style: dashed;
  }

  .etikett {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--tiefgruen);
    font-family: var(--schrift-text);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    vertical-align: middle;
  }

  @media (min-width: 60rem) {
    .raster {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
