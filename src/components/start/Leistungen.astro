---
import Icon from '../Icon.astro';
import LeistungsKarten from '../LeistungsKarten.astro';
---

<section class="abschnitt" aria-labelledby="leistungen-titel">
  <div class="huelle">
    <div class="abschnittskopf">
      <p class="kicker">Leistungen</p>
      <h2 id="leistungen-titel">Alles rund um Ihre Bäume</h2>
      <p class="einleitung">
        Unser Schwerpunkt sind Baumpflege und Baumfällung. Dazu übernehmen wir die Arbeiten, die damit zusammenhängen,
        vom Häckseln bis zur Wurzelstockentfernung.
      </p>
    </div>

    <LeistungsKarten />

    <aside class="gewerbe" aria-labelledby="gewerbe-titel">
      <div>
        <h3 id="gewerbe-titel">Für Hausverwaltungen und Gewerbe</h3>
        <p>
          Regelmäßige Pflege, Rahmenverträge und ein fester Ansprechpartner. Wir unterstützen Sie bei der
          Verkehrssicherungspflicht, mit planbaren Kosten und wenig Aufwand für Sie.
        </p>
      </div>
      <a class="knopf knopf--hell" href="/gewerbe-hausverwaltungen/">Angebot für Gewerbe <Icon name="pfeil" /></a>
    </aside>
  </div>
</section>

<style>
  .abschnittskopf .kicker {
    font-size: 1.15rem;
  }

  .gewerbe {
    margin-top: 1.25rem;
    background: var(--salbei);
    --fokus: var(--gold-hell);
    color: var(--auf-dunkel);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  .gewerbe h3 {
    color: var(--auf-dunkel);
    margin-bottom: 0.5rem;
  }

  .gewerbe p {
    color: var(--auf-dunkel-weich);
    max-width: 44rem;
  }

  .gewerbe .knopf {
    justify-self: start;
  }

  @media (min-width: 64rem) {
    .gewerbe {
      grid-template-columns: 1fr auto;
    }
  }
</style>
