---
import Marke from './Marke.astro';
import Icon from './Icon.astro';
import { betrieb, telefonLink, whatsappLink, mailLink } from '../config/betrieb';
import { fussmenue, rechtliches } from '../config/navigation';
import { sichtbareLeistungen, leistungsUrl } from '../lib/inhalte';
import { socialProfile } from '../lib/profile';

const leistungen = await sichtbareLeistungen();
const social = socialProfile();
const jahr = new Date().getFullYear();
---

<footer class="fuss">
  <div class="huelle fuss__raster">
    <div class="fuss__betrieb">
      <a href="/" class="fuss__logo"><Marke negativ mitEmblem={false} titel="Baumpflege Happe, zur Startseite" sizes="4.75rem" /></a>
      <p class="fuss__unterzeile">{betrieb.unterzeile}</p>
      <address>
        {betrieb.name}<br />
        Inhaber {betrieb.inhaber}<br />
        {betrieb.adresse.strasse}<br />
        {betrieb.adresse.plz} {betrieb.adresse.ort}
      </address>
    </div>

    <nav aria-labelledby="fuss-leistungen">
      <h2 id="fuss-leistungen">Leistungen</h2>
      <ul>
        {leistungen.map((l) => <li><a href={leistungsUrl(l.id)}>{l.data.titel}</a></li>)}
      </ul>
    </nav>

    <nav aria-labelledby="fuss-betrieb">
      <h2 id="fuss-betrieb">Betrieb</h2>
      <ul>
        {fussmenue.map((p) => <li><a href={p.href}>{p.titel}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2>Kontakt</h2>
      <ul class="fuss__kontakt">
        <li><a href={telefonLink}><Icon name="telefon" />{betrieb.telefon.anzeige}</a></li>
        <li><a href={whatsappLink}><Icon name="whatsapp" />WhatsApp</a></li>
        <li><a href={mailLink}><Icon name="mail" />{betrieb.email}</a></li>
        <li class="fuss__zeiten"><Icon name="uhr" /><span>{betrieb.erreichbarkeit}</span></li>
      </ul>
      {
        social.length > 0 && (
          <>
            <h2 class="fuss__folgen">Folgen Sie uns</h2>
            <ul class="fuss__kontakt">
              {social.map((p) =>
                p.href ? (
                  <li>
                    <a href={p.href} rel="noopener">
                      <Icon name={p.icon} />
                      {p.name}
                    </a>
                  </li>
                ) : (
                  <li class="fuss__folgt">
                    <Icon name={p.icon} />
                    <span>{p.name} (Link folgt)</span>
                  </li>
                ),
              )}
            </ul>
          </>
        )
      }
    </div>
  </div>

  <div class="huelle fuss__unten">
    <p>© {jahr} {betrieb.name}</p>
    <ul>
      {rechtliches.map((p) => <li><a href={p.href}>{p.titel}</a></li>)}
      {betrieb.profile.google && <li><a href={betrieb.profile.google} rel="noopener">Google</a></li>}
    </ul>
  </div>
</footer>

<style>
  .fuss {
    background: var(--salbei-dunkel);
    border-top: 3px solid var(--gold);
    --fokus: var(--gold-licht);
    color: var(--auf-dunkel);
    font-size: 1rem;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }

  .fuss__raster {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .fuss__betrieb {
    grid-column: 1 / -1;
  }

  .fuss__logo {
    display: inline-block;
    --schriftzug: 3.6rem;
  }

  .fuss__unterzeile {
    margin: 0.75rem 0 1.25rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-licht);
  }

  address {
    font-style: normal;
    color: var(--auf-dunkel-weich);
  }

  h2 {
    font-family: var(--schrift-text);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-licht);
    margin-bottom: 0.9rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  a {
    color: var(--auf-dunkel);
    text-decoration: none;
  }

  a:hover {
    color: var(--gold-licht);
    text-decoration: underline;
  }

  .fuss__kontakt a,
  .fuss__zeiten,
  .fuss__folgt {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.6rem;
    overflow-wrap: anywhere;
  }

  .fuss__kontakt :global(.icon) {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
    color: var(--gold-licht);
  }

  .fuss__zeiten,
  .fuss__folgt {
    color: var(--auf-dunkel-weich);
  }

  .fuss__folgen {
    margin-top: 1.75rem;
  }

  .fuss__unten {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--gold) 40%, transparent);
    color: var(--auf-dunkel-weich);
    font-size: 0.95rem;
  }

  .fuss__unten ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  @media (min-width: 64rem) {
    .fuss__raster {
      grid-template-columns: 1.3fr 1fr 1fr 1.2fr;
    }

    .fuss__betrieb {
      grid-column: auto;
    }
  }
</style>
