# Serverkonfiguration für Hostinger (LiteSpeed, Apache-kompatibel).
# Diese Datei wird bei jedem Deployment hochgeladen und überschreibt die Datei auf dem Server.
# Deshalb im hPanel keine Werkzeuge nutzen, die in die .htaccess schreiben ("Redirects", "Password Protect Directories").
# HTTPS erzwingt der hPanel-Schalter "Force HTTPS" (Security -> SSL), nicht diese Datei.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

AddType image/avif .avif
AddType image/webp .webp
AddType video/webm .webm
AddType font/woff2 .woff2

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Eine einzige Schreibweise der Domain: ohne www (www.baumpflege-happe.de -> baumpflege-happe.de)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Übliche Sitemap-Adresse auf die von Astro erzeugte Sitemap
  RewriteRule ^sitemap\.xml$ /sitemap-index.xml [R=301,L]

  # Hilfsdateien des Formulars sperren (zusätzlich zur .htaccess im Ordner)
  RewriteRule ^anfrage/lib/ - [F,L]

  # Versteckte Dateien sperren (z. B. .git), .well-known für Zertifikate erlauben
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (^|/)\. - [F]
</IfModule>

<IfModule mod_headers.c>
  # Sicherheits-Header. Die Content-Security-Policy für Skripte, Styles und Bilder steht als <meta> in jeder Seite.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
  # HSTS erst bei der Liveschaltung aktivieren, wenn HTTPS stabil läuft:
  # Header always set Strict-Transport-Security "max-age=31536000"

  # HTML immer frisch prüfen, damit Änderungen sofort sichtbar sind
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Bilder, Videos und Schriften ohne Prüfsumme im Namen: 7 Tage
  <FilesMatch "\.(avif|webp|jpe?g|png|svg|ico|mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
